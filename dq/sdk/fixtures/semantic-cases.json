    {
      "id": "counts-exact-two-thirds-boundary",
      "semantics": "counts/v1",
      "why": "Two of three rows are present: exactly 2/3, which no finite decimal equals. The kernel compares exactly; an engine comparing doubles finds 0.6666666666666666 equal to 2/3.",
      "columns": [
        [
          "id",
          "string"
        ],
        [
          "filler",
          "long"
        ]
      ],
      "rows": [
        [
          "a",
          1
        ],
        [
          "b",
          2
        ],
        [
          null,
          3
        ]
      ],
      "rules": [
        {
          "rule_id": "two_thirds_at_least",
          "kind": "completeness",
          "operator": "ge",
          "threshold": "0.6666666666666666",
          "column": "id"
        },
        {
          "rule_id": "two_thirds_above",
          "kind": "completeness",
          "operator": "gt",
          "threshold": "0.6666666666666666",
          "column": "id"
        },
        {
          "rule_id": "two_thirds_at_most",
          "kind": "completeness",
          "operator": "le",
          "threshold": "0.6666666666666666",
          "column": "id"
        },
        {
          "rule_id": "two_thirds_exactly_the_double",
          "kind": "completeness",
          "operator": "eq",
          "threshold": "0.6666666666666666",
          "column": "id"
        },
        {
          "rule_id": "two_thirds_exactly_rounded_up",
          "kind": "completeness",
          "operator": "eq",
          "threshold": "0.66666666666666666666666666666667",
          "column": "id"
        }
      ],
      "metrics": {
        "row_count": 3,
        "present_count:id": 2
      },
      "expected": {
        "two_thirds_at_least": true,
        "two_thirds_above": true,
        "two_thirds_at_most": false,
        "two_thirds_exactly_the_double": false,
        "two_thirds_exactly_rounded_up": false
      },
      "deequ_diverges": {
        "two_thirds_at_most": "Deequ compares doubles and finds 2/3 at most 0.6666666666666666; exactly, it is greater.",
        "two_thirds_above": "Deequ compares doubles and finds 2/3 equal to, not above, 0.6666666666666666.",
        "two_thirds_exactly_the_double": "Deequ compares doubles and finds 2/3 equal to 0.6666666666666666.",
        "two_thirds_exactly_rounded_up": "Deequ compares doubles, and 0.66666666666666666666666666666667 is the same double as 0.6666666666666666, so it finds 2/3 equal to it; exactly, 2/3 is less."
      }
    },
